sensor ts @this @timescale
set ctrlcc 4
jump 6 lessThanEq ts 1
set ctrlcc 5
jump 6 lessThanEq ts 2
set ctrlcc 8
op mod un un ctrlcc
op add un un 1
op mul counter un 5
op add @counter counter 5
set myCarrier mC1
set carryType @silicon
set scanFac scan1
set toCore 0
jump 69 always 0 0
set myCarrier mC2
set carryType @plastanium
set scanFac scan2
set toCore 0
jump 69 always 0 0
